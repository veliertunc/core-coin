{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CoreCoin: refresh compile_commands.json",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/build.py", "--configure-only"],
      "options": {"cwd": "${workspaceFolder}"},
      "runOptions": {"runOn": "folderOpen"},
      "problemMatcher": []
    },
    {
      "label": "CoreCoin: build and test",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/build.py", "--test"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
